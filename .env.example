# OpenAI-compatible LLM provider (used by the default LLM client)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MODEL=deepseek-flash
OPENAI_COMPATIBLE_PROVIDER_NAME=openai-compatible
# Reasoning/thinking effort. Set to `none` for DeepSeek-style reasoning models
# (their hidden thinking phase otherwise consumes the summary output budget).
OPENAI_COMPATIBLE_REASONING_EFFORT=none

# Subtitle fetching
# YouTube captions are downloaded through savesubs.com; an auth token is optional but often required.
SAVESUBS_X_AUTH_TOKEN=
SAVESUBS_BASE_URL=https://savesubs.com
# Bilibili captions require a logged-in SESSDATA cookie (comma separated to rotate).
BILIBILI_SESSION_TOKEN=
