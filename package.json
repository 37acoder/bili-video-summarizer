{
  "name": "video-summarizer",
  "version": "0.1.0",
  "description": "Framework-agnostic module that summarizes YouTube/Bilibili videos by extracting captions and prompting an OpenAI-compatible LLM. Extracted from BibiGPT-v1.",
  "type": "module",
  "license": "GPL-3.0-only",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx examples/basic.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.35",
    "ai": "^6.0.116"
  },
  "devDependencies": {
    "@types/node": "^22.19.13",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
